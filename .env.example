# Copy to .env and change the password. .env is git-ignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used when running the API on your machine (uvicorn). Compose builds its own
# URL for the api container, pointing at the "db" service instead of localhost.
DATABASE_URL=postgres://postgres:change-me@localhost:5433/tasks
